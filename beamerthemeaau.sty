\mode<presentation>


%Pakete
\RequirePackage{tikz}
\usetikzlibrary{positioning}
\RequirePackage{graphicx}
\RequirePackage{ifthen}
\RequirePackage{xcolor}
\RequirePackage{xparse}
\RequirePackage{pgfopts}

\pgfkeys{/aau/.cd,
	.search also={
		/aau/inner,
		/aau/outer,
		/aau/color,
		/aau/font,
	}
}

\pgfkeys{
	/aau/block/.cd,
	.is choice,
	transparent/.code=\aau@block@transparent,
	fill/.code=\aau@block@fill
}

\newcommand{\aau@block@transparent}{
	\setbeamercolor{block title}{bg=red}
	\setbeamercolor{block body}{bg=red}
}
\newcommand{\aau@block@fill}{
	\setbeamercolor{block title}{bg=yellow}
	\setbeamercolor{block body}{bg=yellow}
}

\ProcessPgfPackageOptions{/aau}
%Einstellungen
\useinnertheme{aau}
\useoutertheme{aau}
\usecolortheme{aau}
\usefonttheme{aau}

%Environments
\NewDocumentEnvironment{authquote}{O{}}
{
	\begin{quotation}
	}
	{
		\IfNoValueF{#1}{
			\par\smallskip
			\raggedleft\normalfont\bfseries #1
		}
	\end{quotation}
}


\mode<all>

