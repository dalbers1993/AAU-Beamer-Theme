\RequirePackage{etoolbox}
\RequirePackage{pgfkeys}
\RequirePackage{pgfopts}
\RequirePackage{xcolor}

% Farben definieren
\definecolor{aaulightblue}{RGB}{85, 158, 195}
\definecolor{aaudarkblue}{RGB}{50, 103, 125}
\definecolor{aaulightred}{RGB}{184, 58, 58}
\definecolor{aaudarkred}{RGB}{110, 35, 35}
\definecolor{aaulightgreen}{RGB}{80, 160, 80}
\definecolor{aaudarkgreen}{RGB}{48, 96, 48}


% Titelseite
\setbeamercolor{title}{fg=white}
\setbeamercolor{subtitle}{fg=white}
\setbeamercolor{author}{fg=white}
\setbeamercolor{institute}{fg=white}
\setbeamercolor{date}{fg=white}

% Sectionseite
\setbeamercolor{section}{fg=white}
\setbeamercolor{subsection}{fg=white}


% Titel
\setbeamercolor{frametitle}{fg=black}


% Blöcke
\setbeamercolor{block title example}{bg=aaudarkblue,fg=white}
\setbeamercolor{block body example}{bg=aaulightblue,fg=white}

\setbeamercolor{block title alerted}{bg=aaudarkred,fg=white}
\setbeamercolor{block body alerted}{bg=aaulightred,fg=white}

\setbeamercolor{block title}{bg=aaudarkgreen,fg=white}
\setbeamercolor{block body}{bg=aaulightgreen,fg=white}


\setbeamercolor{section in toc}{fg=aaudarkblue}
\setbeamercolor{subsection in toc}{fg=aaudarkblue}

\setbeamercolor{alerted text}{fg=aaulightred}
\setbeamercolor{structure}{fg=aaulightblue}
