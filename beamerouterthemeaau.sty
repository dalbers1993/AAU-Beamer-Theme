}


\setbeamertemplate{footline}{
	\textcolor{\aau@outer@footlinerulecolor}{\rule{\textwidth}{\aau@outer@footlinerule}}
	\begin{beamercolorbox}[wd=\textwidth, ht=1.3em,  dp=0.7em, leftskip=0.3em, rightskip=0.3em]{colorbox}
		\aau@outer@footlinetext
	\end{beamercolorbox}
}

\setbeamertemplate{navigation symbols}{}

% Sidebar
\newcommand{\nosidebar}{
	\setbeamertemplate{sidebar left}{}
}

\newcommand{\sidebarleft}{
	\setbeamersize{sidebar width left=3em}
	\setbeamertemplate{sidebar left}{
		\begin{tikzpicture}[remember picture, overlay]
			\node[top color=aaudarkblue, bottom color=aaulightblue, text width=8em, minimum height=\paperheight-\footheight+0.8em,inner sep=1em, text=white, anchor=north west] (sidebarleft) at ([xshift=-1pt]current page.north west) {
				\begin{minipage}[t]{10em}
					\raggedright
					\setbeamercolor{section in toc}{fg=white}
					\setbeamertemplate{section in toc}{
						\inserttocsectionnumber. \inserttocsection\vspace{1em}
					}
					\tableofcontents
				\end{minipage}
			};
		\end{tikzpicture}
	}
}

\newcommand{\sidebarright}{
	\setbeamersize{sidebar width right=3em}
	\setbeamertemplate{sidebar right}{
		\begin{tikzpicture}[remember picture, overlay]
			\node[top color=aaudarkblue, bottom color=aaulightblue, text width=8em, minimum height=\paperheight-\footheight+0.8em,inner sep=1em, text=white, anchor=north east] (sidebarright) at ([xshift=1pt]current page.north east) {
				\begin{minipage}[t]{10em}
					\raggedright
					\setbeamercolor{section in toc}{fg=white}
					\setbeamertemplate{section in toc}{
						\inserttocsectionnumber. \inserttocsection\vspace{1em}
					}
					\tableofcontents
				\end{minipage}
			};
		\end{tikzpicture}
	}
}

\pgfkeys{
	/aau/outer/sidebar/.cd,
	.is choice,
	off/.code=\nosidebar,
	left/.code=\sidebarleft,
	right/.code=\sidebarright
}



