\mode<presentation>

% Title and part pages.
\newcommand{\aau@inner@bg}{
	\includegraphics[width=\paperwidth, height=\paperheight]{background}
}


\pgfkeys{
	/aau/inner/bg/.cd,
	.is choice,
	aau/.code= \let\aau@inner@bg\aau@inner@bg,
	none/.code=\let\aau@inner@bg\@empty,
}

\setbeamertemplate{background canvas}{
	\ifbeamer@plainframe
	{}
	\else
	\aau@inner@bg
	\fi
}

\setbeamertemplate{title page}{
	\begin{tikzpicture}[remember picture, overlay]
		\fill[aaudarkblue] (current page.south west) rectangle (current page.north east);
		\node (title) at ([yshift=1cm]current page.center) {\usebeamercolor[fg]{title}\usebeamerfont{title}\inserttitle};
		\node [below = 1em of title] (subtitle) {\usebeamercolor[fg]{subtitle}\usebeamerfont{subtitle}\insertsubtitle};
		\ifthenelse{\equal{\insertsubtitle}{}}{
			\node [below = 2em of title] (author) {\usebeamercolor[fg]{author}\usebeamerfont{author}\insertauthor};}{
			\node [below = 2em of subtitle] (author) {\usebeamercolor[fg]{author}\usebeamerfont{author}\insertauthor};}		
	\end{tikzpicture}
}

\setbeamertemplate{section page}{
	\begin{tikzpicture}[remember picture, overlay]
		\fill[aaudarkblue] (current page.south west) rectangle (current page.north east);
		\node (section title) at ([yshift=1cm]current page.center) {\usebeamercolor[fg]{section}\usebeamerfont{section}\insertsection};
		\node [below = 1em of section title] (subsection title) {\usebeamercolor[fg]{subsection}\usebeamerfont{subsection}\insertsubsection};
	\end{tikzpicture}
}

\setbeamertemplate{subsection page}{
	\begin{tikzpicture}[remember picture, overlay]
		\fill[aaudarkblue] (current page.south west) rectangle (current page.north east);
		\node at (current page.center) (subsection title) {\usebeamercolor[fg]{subsection}\usebeamerfont{subsection}\insertsubsection};
	\end{tikzpicture}
}

% Itemize environments.
% NEEDS WORK DIE SYMBOLE SIND NICHT MITTIG ZUM TEXT WIE BEI STANDARD
\newcommand{\aau@inner@itemsymbol}{$\blacktriangleright$}
\newcommand{\aau@inner@subitemsymbol}{\textbullet}
\newcommand{\aau@inner@subsubitemsymbol}{\textendash}

\pgfkeys{
	/aau/inner/.cd,
	itemsymbol/.store in=\aau@inner@itemsymbol,
	subitemsymbol/.store in=\aau@inner@subitemsymbol,
	subsubitemsymbol/.store in=\aau@inner@subsubitemsymbol,
}

\setbeamertemplate{itemize item}{\aau@inner@itemsymbol}
\setbeamertemplate{itemize subitem}{\aau@inner@subitemsymbol}
\setbeamertemplate{itemize subsubitem}{\aau@inner@subsubitemsymbol}

% Enumerate environments.
% FUNKTIONIERT NICHT
\newcommand{\aau@inner@enumsymbol}{\arabic{enumi}.}
\newcommand{\aau@inner@subenumsymbol}{\alph{enumii}.}
\newcommand{\aau@inner@subsubenumsymbol}{\roman{enumiii}.}

\pgfkeys{
	/aau/inner/.cd,
	enumsymbol/.store in=\aau@inner@enumsymbol,
	subenumsymbol/.store in=\aau@inner@subenumsymbol,
	subsubenumsymbol/.store in=\aau@inner@subsubenumsymbol,
}

\setbeamertemplate{enumerate item}{\aau@inner@enumsymbol}
\setbeamertemplate{enumerate subitem}{\aau@inner@subenumsymbol}
\setbeamertemplate{enumerate subsubitem}{\aau@inner@subsubenumsymbol}

% Description environments.

% Block environments.
\setbeamertemplate{blocks}[rounded][shadow]

% Theorem and proof environments.

% Figures and tables.

% Footnotes.

% Bibliography entries.
\setbeamertemplate{section in toc}{
	\inserttocsectionnumber. \inserttocsection
}
\setbeamertemplate{subsection in toc}{}
\setbeamertemplate{subsubsection in toc}{}


\ProcessPgfOptions{/aau/inner}

\mode<all>